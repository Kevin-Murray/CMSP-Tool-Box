<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.control.ToggleGroup?>
<AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="504.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="cmsp.tool.box.gui.DiscoveryReportsPdController">
    <children>
        <VBox prefHeight="504.0" prefWidth="600.0">
            <children>
                <MenuBar prefWidth="600.0">
                    <menus>
                        <Menu mnemonicParsing="false" text="File">
                            <items>
                                <MenuItem mnemonicParsing="false" text="Close"/>
                            </items>
                        </Menu>
                        <Menu mnemonicParsing="false" text="Help">
                            <items>
                                <MenuItem mnemonicParsing="false" text="About"/>
                            </items>
                        </Menu>
                    </menus>
                </MenuBar>
                <AnchorPane prefHeight="68.0" prefWidth="600.0">
                    <children>
                        <Label layoutX="14.0" layoutY="17.0" text="Projects Found:"/>
                        <TextField fx:id="projectNumberBox" layoutX="102.0" layoutY="13.0" prefHeight="25.0"
                                   prefWidth="53.0" editable="false" focusTraversable="false"/>
                        <Label layoutX="169.0" layoutY="17.0" prefHeight="17.0" prefWidth="89.0" text="Project:"/>
                        <ChoiceBox fx:id="projectIdBox1" layoutX="218.0" layoutY="13.0" prefHeight="25.0"
                                   prefWidth="368.0" onAction="#updateProjectChoice"/>
                    </children>
                </AnchorPane>
                <TableView fx:id="projectReportTable" prefHeight="362.0" prefWidth="600.0">
                    <columns>
                        <TableColumn prefWidth="135.0" text="Report Field"/>
                        <TableColumn prefWidth="464.0" text="File Name"/>
                    </columns>
                </TableView>
                <AnchorPane prefHeight="70.0" prefWidth="600.0">
                    <children>
                        <RadioButton layoutX="360.0" layoutY="18.0" mnemonicParsing="false" text="Process All Projects">
                            <toggleGroup>
                                <ToggleGroup fx:id="process"/>
                            </toggleGroup>
                        </RadioButton>
                        <RadioButton layoutX="107.0" layoutY="18.0" mnemonicParsing="false" selected="true" text="Process Selected Project" toggleGroup="$process"/>
                    </children>
                </AnchorPane>
                <ButtonBar prefHeight="40.0" prefWidth="600.0"
                           style="-fx-background-color: E8E8E8; -fx-border-color: C4C4C4;">
                    <buttons>
                        <Button fx:id="previousButton" mnemonicParsing="false" prefHeight="30.0"
                                prefWidth="80.0" text="Previous" onAction="#previousButton1Clicked">
                            <font>
                                <Font size="14.0"/>
                            </font>
                        </Button>
                        <Button fx:id="nextButton" mnemonicParsing="false" onAction="#nextButton1Clicked"
                                prefWidth="80.0" text="Next">
                            <font>
                                <Font size="14.0"/>
                            </font>
                        </Button>
                    </buttons>
                    <opaqueInsets>
                        <Insets/>
                    </opaqueInsets>
                    <padding>
                        <Insets right="10.0"/>
                    </padding>
                </ButtonBar>
            </children>
        </VBox>
    </children>
</AnchorPane>
