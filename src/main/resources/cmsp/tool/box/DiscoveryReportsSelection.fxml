<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="504.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cmsp.tool.box.gui.DiscoveryReportsSelectionController">
   <children>
      <MenuBar layoutY="2.0" prefWidth="600.0">
        <menus>
          <Menu mnemonicParsing="false" text="File">
            <items>
              <MenuItem mnemonicParsing="false" text="Close" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Help">
            <items>
              <MenuItem mnemonicParsing="false" text="About" />
            </items>
          </Menu>
        </menus>
      </MenuBar>
      <ListView fx:id="discoveryLists" layoutX="14.0" layoutY="42.0" prefHeight="250.0" prefWidth="319.0" />
      <ImageView fx:id="discoveryImage" fitHeight="250.0" fitWidth="250.0" layoutX="344.0" layoutY="42.0" pickOnBounds="true" preserveRatio="true">
       <image>
           <Image url="@icons/discoveryDefault.png" />
       </image>
      </ImageView>
      <TextArea fx:id="discoveryMessage" layoutX="18.0" layoutY="297.0" prefHeight="65.0" prefWidth="572.0" wrapText="true" />
      <Line endX="470.0" layoutX="115.0" layoutY="378.0" startX="-100.0" stroke="#aeaeae" strokeLineCap="ROUND" strokeMiterLimit="20.0" strokeWidth="2.0" />
      <Label fx:id="discoveryLabel" layoutX="18.0" layoutY="387.0" prefHeight="30.0" prefWidth="527.0" text="Project Directory:">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <TextField fx:id="projectPath" layoutX="18.0" layoutY="420.0" prefHeight="25.0" prefWidth="527.0" />
      <Button fx:id="searchButton" alignment="TOP_CENTER" contentDisplay="CENTER" layoutX="554.0" layoutY="420.0" mnemonicParsing="false" onAction="#openDocumentClick" prefHeight="25.0" prefWidth="33.0" text="..." disable="true" textAlignment="CENTER" />
      <ButtonBar  layoutY="464.0" prefHeight="40.0" prefWidth="600.0" style="-fx-background-color: E8E8E8; -fx-border-color: C4C4C4;">
         <buttons>
            <Button fx:id="previousButton" disable="true" mnemonicParsing="false" prefHeight="30.0" prefWidth="80.0" text="Previous">
               <font>
                  <Font size="14.0" />
               </font>
            </Button>
            <Button fx:id="nextButton" disable="true" mnemonicParsing="false" onAction="#nextButtonClicked" prefWidth="80.0" text="Next">
               <font>
                  <Font size="14.0" />
               </font>
            </Button>
         </buttons>
         <opaqueInsets>
            <Insets />
         </opaqueInsets>
         <padding>
            <Insets right="10.0" />
         </padding>
      </ButtonBar>
   </children>
</AnchorPane>
